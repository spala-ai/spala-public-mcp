PORT=4100
PUBLIC_BASE_URL=https://mcp.spala.ai
SPALA_AGENT_A2A_RESOURCE_URL=https://agent.spala.ai/a2a/jsonrpc
# Required platform API origin. This service has no production-origin fallback.
SPALA_API_BASE_URL=
PUBLIC_OAUTH_ENCRYPTION_SECRET=
PUBLIC_MCP_PLATFORM_SERVICE_SECRET=
# Dedicated persistent 0700 directory shared by every worker; never use the filesystem root.
PUBLIC_OAUTH_REPLAY_STATE_PATH=/var/lib/mcp-spala-ai/oauth-replay
PUBLIC_OAUTH_TICKET_LIFETIME_SECONDS=300
PUBLIC_OAUTH_CODE_LIFETIME_SECONDS=60
PUBLIC_OAUTH_CLIENT_LIFETIME_SECONDS=2592000
PUBLIC_OAUTH_RATE_LIMIT_MAX=120
PUBLIC_OAUTH_BODY_LIMIT_BYTES=32768
PUBLIC_MCP_PLATFORM_TIMEOUT_MS=8000
PUBLIC_MCP_PLATFORM_RESPONSE_LIMIT_BYTES=1048576
# Exact HTTPS origins allowed to receive project-entry tokens for /<slug>/mcp shared mounts.
# Leave empty when every project MCP is served from its authenticated project URL.
PUBLIC_MCP_TRUSTED_SHARED_RUNTIME_ORIGINS=
SPALA_DASHBOARD_URL=https://dashboard.spala.ai
SPALA_PRICING_URL=https://spala.ai/pricing/
SPALA_DOCS_URL=https://docs.spala.ai/agents/mcp
CORS_ALLOWED_ORIGINS=https://app.spala.ai,https://spala.ai
MCP_BODY_LIMIT_BYTES=1048576
MCP_RATE_LIMIT_MAX=120
# Funnel telemetry: NDJSON event files (no tokens, no user identifiers) written
# one-per-UTC-day under this directory. Report: node scripts/telemetry-report.mjs --dir <path>
# Unset uses .state/telemetry relative to the working directory. TELEMETRY_DISABLED=1 turns it off.
TELEMETRY_STATE_PATH=
TELEMETRY_DISABLED=
